# Origen real del backend. Solo servidor/build: el navegador nunca lo usa
# directo, habla con el proxy same-origin /api/backend (ver next.config.ts).
# También de ahí sale la URL del WebSocket (NEXT_PUBLIC_WS_URL).
BACKEND_URL=http://localhost:3001

# Opcional: CDN de assets del editor (@pascal-app/viewer).
# NEXT_PUBLIC_ASSETS_CDN_URL=https://editor.pascal.app

# Origen del bucket de modelos AR (Neon Object Storage), sin '/' final.
# El GLB se sube con un PUT prefirmado directo al bucket, así que tiene que
# estar en el connect-src del CSP (ver next.config.ts). Se hornea en el build.
# Sin esto, "Generar y publicar GLB" falla con "No se pudo conectar con el
# almacenamiento del modelo".
# MODELOS_ORIGIN=https://<rama>.storage.<region>.aws.neon.tech

# Generación de proyectos con IA (OpenRouter). Todo opcional: si falta, se usan
# los defaults hardcodeados de src/lib/ia/proyecto/modelos.ts.
# OPENROUTER_API_KEY=
# OPENROUTER_API_KEYS=clave1,clave2
# OPENROUTER_MODEL_PROYECTO_GRATIS=nvidia/nemotron-3.5-super-vl:free
# OPENROUTER_MODEL_PROYECTO_ECONOMICO=anthropic/claude-haiku-4.5
# OPENROUTER_MODEL_PROYECTO_EQUILIBRADO=anthropic/claude-sonnet-5.5
# OPENROUTER_MODEL_PROYECTO_PRECISION=openai/gpt-5.5
# OPENROUTER_PERFIL_PROYECTO_DEFECTO=equilibrado
